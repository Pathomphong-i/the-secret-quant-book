# ==============================================================================
# The Secret Quant: 8-Volume Masterclass Series — Environment Configuration
# คัดลอกไฟล์นี้เป็น .env ก่อนรันระบบจริง (cp .env.example .env)
# ==============================================================================

# 1. Google Gemini API Key (สำหรับเล่มที่ 7: วิเคราะห์ข่าวแจ้งตลาดฯ และงบการเงินแบบ Strict JSON)
GEMINI_API_KEY=

# 2. Settrade Open API v2 Credentials (สำหรับเล่มที่ 6 และ เล่มที่ 8: เชื่อมกระดานหุ้นไทย & TFEX)
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_BROKER_ID=SANDBOX
SETTRADE_APP_CODE=SANDBOX
SETTRADE_EQUITY_ACCOUNT_NO=
SETTRADE_DERIVATIVES_ACCOUNT_NO=

# 3. Telegram Bot Notification (สำหรับเล่มที่ 8: แจ้งเตือนคำสั่งซื้อขายและเบรกเกอร์ฉุกเฉิน)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
